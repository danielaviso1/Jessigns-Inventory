<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Jessigns Management</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <div class="d-flex">
    <div class="flex-column p-3 bg-light" style="width: 250px; height: 100vh;">
      <h4>Jessigns</h4>
      <ul class="nav nav-pills flex-column" id="tabMenu">
        <li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#dashboard">Dashboard</a></li>
        <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#orders">Orders</a></li>
        <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#inventory">Inventory</a></li>
        <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#products">Products</a></li>
      </ul>
    </div>

    <div class="tab-content p-4" style="width: 100%;">
      <div id="dashboard" class="tab-pane fade show active">
        <div class="row">
            <div class="col-md-3">
              <div class="card text-white bg-primary mb-3">
                <div class="card-body">
                  <h5 class="card-title">Total Orders</h5>
                  <p class="card-text fs-4"><%= summary.totalOrders || 0 %></p>
                </div>
              </div>
            </div>
            <div class="col-md-3">
              <div class="card text-white bg-success mb-3">
                <div class="card-body">
                  <h5 class="card-title">Total Revenue</h5>
                  <p class="card-text fs-4">$<%= (summary.totalRevenue || 0).toFixed(2) %></p>
                </div>
              </div>
            </div>
            <div class="col-md-3">
              <div class="card text-dark bg-warning mb-3">
                <div class="card-body">
                  <h5 class="card-title">Pending Orders</h5>
                  <p class="card-text fs-4"><%= statusSummary.Pending || 0 %></p>
                </div>
              </div>
            </div>
            <div class="col-md-3">
              <div class="card text-white bg-success mb-3">
                <div class="card-body">
                  <h5 class="card-title">Completed Orders</h5>
                  <p class="card-text fs-4"><%= statusSummary.Completed || 0 %></p>
                </div>
              </div>
            </div>
          </div>          
      </div>
      
      <div id="orders" class="tab-pane fade">
        <h3>Orders</h3>
        <form action="/add-order" method="POST" enctype="multipart/form-data" class="mb-4">
          <input name="customerName" class="form-control mb-2" placeholder="Customer Name" required>
          <select name="productId" class="form-control mb-2">
            <% products.forEach(p => { %>
              <option value="<%= p.id %>"><%= p.product %> - P<%= p.price %></option>
            <% }) %>
          </select>
          <input type="number" name="quantity" class="form-control mb-2" placeholder="Quantity" required>
          <input type="date" name="dateOrdered" class="form-control mb-2" required>
          <input type="date" name="dateCommitted" class="form-control mb-2">
          <select name="status" class="form-control mb-2" required>
            <option value="Pending">Pending</option>
            <option value="Completed">Completed</option>
          </select>
          <input type="file" name="file" class="form-control mb-2">
          <button class="btn btn-primary">Add Order</button>
        </form>

        <table class="table table-bordered">
          <thead>
            <tr>
              <th>Customer Name</th><th>Product Ordered</th><th>Quantity</th><th>Total Price</th>
              <th>Date Ordered</th><th>Date Committed</th><th>Status</th><th>File</th>
            </tr>
          </thead>
          <tbody>
            <% orders.forEach(order => { %>
                <tr>
                  <td><%= order.customerName %></td>
                  <td><%= order.productName %></td>
                  <td><%= order.quantity %></td>
                  <td>$<%= order.totalPrice.toFixed(2) %></td>
                  <td><%= order.dateOrdered %></td>
                  <td><%= order.dateCommitted %></td>
                  <td><%= order.status %></td>
                  <td>
                    <% if (order.file) { %>
                      <img src="<%= order.file %>" width="50">
                    <% } %>
                  </td>
                  <td>
                    <button class="btn btn-sm btn-warning" data-bs-toggle="modal" data-bs-target="#editModal<%= order.id %>">Edit</button>
                    <form action="/delete-order/<%= order.id %>" method="POST" style="display:inline;">
                      <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                    </form>
                  </td>
                </tr>
              
                <!-- Edit Modal -->
                <div class="modal fade" id="editModal<%= order.id %>" tabindex="-1">
                  <div class="modal-dialog">
                    <div class="modal-content">
                      <form action="/update-order/<%= order.id %>" method="POST" enctype="multipart/form-data">
                        <div class="modal-header">
                          <h5 class="modal-title">Edit Order</h5>
                          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                          <input name="customerName" class="form-control mb-2" value="<%= order.customerName %>" required>
                          <select name="productId" class="form-control mb-2">
                            <% products.forEach(p => { %>
                              <option value="<%= p.id %>" <% if (p.id === order.productId) { %>selected<% } %>>
                                <%= p.product %> - $<%= p.price %>
                              </option>
                            <% }) %>
                          </select>
                          <input type="number" name="quantity" class="form-control mb-2" value="<%= order.quantity %>" required>
                          <input type="date" name="dateOrdered" class="form-control mb-2" value="<%= order.dateOrdered %>" required>
                          <input type="date" name="dateCommitted" class="form-control mb-2" value="<%= order.dateCommitted %>">
                          <select name="status" class="form-control mb-2" value="<%= order.status %>" required>
                            <option value="Pending">Pending</option>
                            <option value="Completed">Completed</option>
                          </select>
                          <input type="file" name="file" class="form-control mb-2">
                        </div>
                        <div class="modal-footer">
                          <button class="btn btn-primary">Save changes</button>
                        </div>
                      </form>
                    </div>
                  </div>
                </div>
              <% }) %>              
          </tbody>
        </table>
      </div>

      <div id="inventory" class="tab-pane fade">
        <h3>Inventory</h3>
      
        <!-- Add Item Form -->
        <form action="/add-inventory" method="POST" class="mb-4">
          <div class="row">
            <div class="col-md-3">
              <input name="itemName" class="form-control mb-2" placeholder="Item Name" required>
            </div>
            <div class="col-md-3">
              <input name="category" class="form-control mb-2" placeholder="Category" required>
            </div>
            <div class="col-md-2">
              <input type="number" name="quantity" class="form-control mb-2" placeholder="Quantity" required>
            </div>
            <div class="col-md-2">
              <input type="number" step="0.01" name="price" class="form-control mb-2" placeholder="Price" required>
            </div>
            <div class="col-md-2">
              <input name="location" class="form-control mb-2" placeholder="Location" required>
            </div>
            <div class="col-md-2">
              <button class="btn btn-primary w-100">Add Item</button>
            </div>
          </div>
        </form>
      
        <!-- Inventory Table -->
        <table class="table table-bordered">
          <thead>
            <tr>
              <th>Item Name</th><th>Category</th><th>Quantity</th><th>Price</th><th>Location</th><th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% inventory.forEach(item => { %>
              <tr>
                <td><%= item.itemName %></td>
                <td><%= item.category %></td>
                <td><%= item.quantity %></td>
                <td>$<%= item.price.toFixed(2) %></td>
                <td><%= item.location %></td>
                <td>
                  <!-- Edit Button -->
                  <button class="btn btn-sm btn-warning" data-bs-toggle="modal" data-bs-target="#editModal<%= item.id %>">Edit</button>
                  <!-- Delete Button -->
                  <form action="/delete-inventory/<%= item.id %>" method="POST" style="display:inline;">
                    <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                  </form>
                </td>
              </tr>
      
              <!-- Edit Modal -->
              <div class="modal fade" id="editModal<%= item.id %>" tabindex="-1">
                <div class="modal-dialog">
                  <div class="modal-content">
                    <form action="/update-inventory/<%= item.id %>" method="POST">
                      <div class="modal-header">
                        <h5 class="modal-title">Edit Inventory Item</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                      </div>
                      <div class="modal-body">
                        <input name="itemName" class="form-control mb-2" value="<%= item.itemName %>" required>
                        <input name="category" class="form-control mb-2" value="<%= item.category %>" required>
                        <input type="number" name="quantity" class="form-control mb-2" value="<%= item.quantity %>" required>
                        <input type="number" step="0.01" name="price" class="form-control mb-2" value="<%= item.price %>" required>
                        <input name="location" class="form-control mb-2" value="<%= item.location %>" required>
                      </div>
                      <div class="modal-footer">
                        <button class="btn btn-primary">Save changes</button>
                      </div>
                    </form>
                  </div>
                </div>
              </div>
            <% }) %>
          </tbody>
        </table>
      </div>
      

      <div id="products" class="tab-pane fade">
        <h3>Products</h3>

<!-- Add Product Form -->
<form action="/add-product" method="POST" class="mb-4">
  <input name="product" class="form-control mb-2" placeholder="Product Name" required>
  <input name="price" type="number" class="form-control mb-2" placeholder="Price" required>
  <button class="btn btn-success">Add Product</button>
</form>

<!-- Products Table -->
<table class="table table-bordered">
  <thead>
    <tr>
      <th>Product</th><th>Price</th><th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% products.forEach(p => { %>
      <tr>
        <td><%= p.product %></td>
        <td>$<%= p.price.toFixed(2) %></td>
        <td>
          <button class="btn btn-sm btn-warning" data-bs-toggle="modal" data-bs-target="#editProductModal<%= p.id %>">Edit</button>
          <form action="/delete-product/<%= p.id %>" method="POST" style="display:inline;">
            <button type="submit" class="btn btn-sm btn-danger">Delete</button>
          </form>
        </td>
      </tr>

      <!-- Edit Modal -->
      <div class="modal fade" id="editProductModal<%= p.id %>" tabindex="-1">
        <div class="modal-dialog">
          <div class="modal-content">
            <form action="/update-product/<%= p.id %>" method="POST">
              <div class="modal-header">
                <h5 class="modal-title">Edit Product</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
              </div>
              <div class="modal-body">
                <input name="product" class="form-control mb-2" value="<%= p.product %>" required>
                <input name="price" type="number" class="form-control mb-2" value="<%= p.price %>" required>
              </div>
              <div class="modal-footer">
                <button class="btn btn-primary">Save changes</button>
              </div>
            </form>
          </div>
        </div>
      </div>
    <% }) %>
  </tbody>
</table>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
